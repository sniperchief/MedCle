# AssemblyAI API key (https://www.assemblyai.com/app/api-keys).
# Server-side only: the browser receives short-lived streaming tokens, never this key.
ASSEMBLYAI_API_KEY=

# Port for the MEDCLE server (optional, defaults to 3000).
PORT=3000

# Anthropic API key (https://platform.claude.com/settings/keys), used server-side
# to extract medication details from completed transcripts.
ANTHROPIC_API_KEY=
